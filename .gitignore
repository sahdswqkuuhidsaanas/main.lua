-- Tool Target Selection
local Mouse = Player:GetMouse()
local Tool = Instance.new("Tool")
Tool.Name = "🎯 Select Player"
Tool.RequiresHandle = false
Tool.Parent = Player:WaitForChild("Backpack")

Tool.Activated:Connect(function()
	local target = Mouse.Target
	if target then
		local character = target:FindFirstAncestorOfClass("Model")
		if character then
			local foundPlayer = Players:GetPlayerFromCharacter(character)
			if foundPlayer and foundPlayer ~= Player then
				NameBox.Text = foundPlayer.Name
			end
		end
	end
end)

-- Feature Logic Handlers
local isBackActive, isHugActive, isFlyActive, isEspActive, isSpeedActive = false, false, false, false, false

BackBtn.MouseButton1Click:Connect(function()
