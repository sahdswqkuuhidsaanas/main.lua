		BackBtn.Text = "چوونە سەر پشت [ON]"
		BackBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
	else
		BackBtn.Text = "چوونە سەر پشت [OFF]"
		BackBtn.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
	end
end)

HugBtn.MouseButton1Click:Connect(function()
	isHugActive = not isHugActive
	if isHugActive then
		isBackActive = false
		BackBtn.Text = "چوونە سەر پشت [OFF]"
		BackBtn.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
