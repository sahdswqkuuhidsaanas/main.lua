-- Actions
TpPlayerBtn.MouseButton1Click:Connect(function()
	if NameBox.Text ~= "" then
		local targetPlayer = GetPlayer(NameBox.Text) or Players:FindFirstChild(NameBox.Text)
		if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
			if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
				Player.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
				Message("Teleport", "تۆ ڕۆشتیت بۆ لای " .. targetPlayer.Name, 2)
			end
		end
	end
end)

BringPlayerBtn.MouseButton1Click:Connect(function()
	if NameBox.Text ~= "" then
		local targetPlayer = GetPlayer(NameBox.Text) or Players:FindFirstChild(NameBox.Text)
		if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
			if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
				targetPlayer.Character.HumanoidRootPart.CFrame = Player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
				Message("Bring", targetPlayer.Name .. " هێنرا بۆ لای تۆ", 2)
			end
		end
	end
end)

-- Empty / Solo Server Finder
SoloServerBtn.MouseButton1Click:Connect(function()
	Message("Empty Server", "دەگەڕێت بۆ سێرڤەری چۆڵ...", 3)
	local placeId = game.PlaceId
	local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
	
	local success, result = pcall(function()
		return HttpService:JSONDecode(game:HttpGet(url))
	end)
	
	if success and result and result.data then
		local targetServer = nil
		for _, s in pairs(result.data) do
			if s.playing and s.playing < s.maxPlayers and s.id ~= game.JobId then
				if not targetServer or s.playing < targetServer.playing then
					targetServer = s
				end
			end
		end
		
		if targetServer then
			Message("Empty Server", "سێرڤەرێک دۆزرایەوە بە " .. tostring(targetServer.playing) .. " یاریزان", 2)
			TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, Player)
		else
			Message("Empty Server", "هیچ سێرڤەرێکی چۆڵتر نەدۆزرایەوە", 2)
		end
	else
		Message("Error", "کێشەیەک لە هێنانی سێرڤەرەکان ڕوویدا", 2)
	end
end)

RejoinBtn.MouseButton1Click:Connect(function()
	Message("Rejoin", "دووبارە دەچیتەوە هەمان سێرڤەر...", 2)
	TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, Player)
end)

-- Positioning Loop
RunService.RenderStepped:Connect(function()
	if NameBox.Text ~= "" then
		local targetPlayer = GetPlayer(NameBox.Text) or Players:FindFirstChild(NameBox.Text)
		if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
			if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
				if isBackActive then
					Player.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 1.2, 0.8)
				elseif isHugActive then
					Player.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -1) * CFrame.Angles(0, math.pi, 0)
				end
			end
		end
	end
end)
